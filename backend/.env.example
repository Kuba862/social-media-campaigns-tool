# Variable names from guide section 10. Names only: real values go to backend/.env (gitignored).
# Never commit real values.

# Meta WhatsApp Cloud API. Used by: API, worker.
META_GRAPH_VERSION=
META_WABA_ID=
META_PHONE_NUMBER_ID=
# The Meta app's id (App Dashboard -> App settings -> Basic). Used by: API, only to upload the
# sample image of a template header through the Resumable Upload API (decision 48).
META_APP_ID=

# Meta secrets. Used by: API (META_SYSTEM_USER_TOKEN also by worker).
# Empty META_SYSTEM_USER_TOKEN keeps the API in drafts-only mode (decision 14).
# Empty META_APP_SECRET or META_WEBHOOK_VERIFY_TOKEN makes /webhooks/meta answer 503 (decision 17).
META_SYSTEM_USER_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Temporal (Temporal Cloud, or the local dev server via ./bin/temporal). Used by: worker only;
# the API enqueues commands in the database and the worker executes them (decision 41).
# Worker defaults to localhost:7233 / default / no key when these are unset (decision 9).
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# Supabase, server side. Used by: API, worker.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Next.js panel. Used by: web; canonical list is web/.env.example, values go to web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Panel access. Used by: web and API (API answers 403 for other domains, decision 8).
PANEL_ALLOWED_EMAIL_DOMAIN=

# Sync connectors. Used by: worker. Connection string of the postgres connector's source database
# (Secret Manager secret sync-postgres-dsn in production); the row's config.dsn_env may rename it.
SYNC_POSTGRES_DSN=

# Sending guard. Used by: worker and API (test send). WA_SEND_MODE is test or live; the PoC never
# sets live. WA_ALLOWED_TEST_RECIPIENTS: comma-separated E.164 numbers allowed in test mode.
WA_SEND_MODE=
WA_ALLOWED_TEST_RECIPIENTS=
