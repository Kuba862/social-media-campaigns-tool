# Variable names from guide section 10. Names only: real values go to backend/.env (gitignored).
# Never commit real values.

# Meta WhatsApp Cloud API. Used by: API, worker.
META_GRAPH_VERSION=
META_WABA_ID=
META_PHONE_NUMBER_ID=

# Meta secrets. Used by: API (META_SYSTEM_USER_TOKEN also by worker).
META_SYSTEM_USER_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Temporal (Temporal Cloud; local dev server via ./bin/temporal). Used by: API, worker.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# Supabase, server side. Used by: API, worker.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Next.js panel. Used by: web (moves to web/.env.local once web/ exists).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PANEL_ALLOWED_EMAIL_DOMAIN=

# Sending guard. Used by: worker. WA_SEND_MODE is test or live; the PoC never sets live.
# WA_ALLOWED_TEST_RECIPIENTS lists the only numbers the send activity accepts in test mode.
WA_SEND_MODE=
WA_ALLOWED_TEST_RECIPIENTS=
